{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaInfo",
  "version": "0.1.0",
  "identifier": "com.mediainfo.desktop",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "title": "MediaInfo",
        "width": 820,
        "height": 560,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
